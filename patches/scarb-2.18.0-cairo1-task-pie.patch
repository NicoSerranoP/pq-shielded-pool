+fn save_stone_air_inputs(runner: &CairoRunner, output_dir: &Utf8Path) -> Result<()> {
+    let trace_path = output_dir.join("trace.bin");
+    let memory_path = output_dir.join("memory.bin");
+    let public_input_path = output_dir.join("air_public_input.json");
+    let private_input_path = output_dir.join("air_private_input.json");
+
+    let relocated_trace = runner
+        .relocated_trace
+        .as_ref()
+        .context("Stone AIR input output requires a relocated execution trace")?;
+
+    let mut trace_file = BufWriter::new(fs::File::create(&trace_path)?);
+    write_encoded_trace(relocated_trace, &mut trace_file)
+        .context("failed to write Stone trace.bin")?;
+
+    let mut memory_file = BufWriter::new(fs::File::create(&memory_path)?);
+    write_encoded_memory(&runner.relocated_memory, &mut memory_file)
+        .context("failed to write Stone memory.bin")?;
+
+    fs::write(
+        public_input_path,
+        runner
+            .get_air_public_input()
+            .context("failed to build Stone AIR public input")?
+            .serialize_json()
+            .context("failed to serialize Stone AIR public input")?,
+    )?;
+
+    fs::write(
+        private_input_path,
+        runner
+            .get_air_private_input()
+            .to_serializable("trace.bin".to_string(), "memory.bin".to_string())
+            .serialize_json()
+            .context("failed to serialize Stone AIR private input")?,
+    )?;
+
+    Ok(())
+}
