{"noir_version":"1.0.0-beta.11+fd3925aaaeb76c76319f44590d135498ef41ea6c","hash":"12605216546202759552","abi":{"parameters":[{"name":"old_note","type":{"kind":"struct","path":"shared::types::Note","fields":[{"name":"value","type":{"kind":"integer","sign":"unsigned","width":32}},{"name":"owner","type":{"kind":"field"}},{"name":"nonce","type":{"kind":"field"}}]},"visibility":"private"},{"name":"new_notes","type":{"kind":"array","length":2,"type":{"kind":"struct","path":"shared::types::Note","fields":[{"name":"value","type":{"kind":"integer","sign":"unsigned","width":32}},{"name":"owner","type":{"kind":"field"}},{"name":"nonce","type":{"kind":"field"}}]}},"visibility":"private"},{"name":"merkle_proof","type":{"kind":"struct","path":"shared::types::MerkleProof","fields":[{"name":"length","type":{"kind":"integer","sign":"unsigned","width":32}},{"name":"indices","type":{"kind":"array","length":30,"type":{"kind":"boolean"}}},{"name":"siblings","type":{"kind":"array","length":30,"type":{"kind":"field"}}}]},"visibility":"private"},{"name":"nullifier","type":{"kind":"field"},"visibility":"public"},{"name":"new_notes_commitments","type":{"kind":"array","length":2,"type":{"kind":"field"}},"visibility":"public"},{"name":"published_root","type":{"kind":"field"},"visibility":"public"}],"return_type":null,"error_types":{"2411771206000632702":{"error_kind":"string","string":"New commitment mismatch"},"2920182694213909827":{"error_kind":"string","string":"attempt to subtract with overflow"},"10577475009954280926":{"error_kind":"string","string":"Nullifiers mismatch"},"17080727174295616896":{"error_kind":"string","string":"Roots mismatch"}}},"bytecode":"","debug_symbols":"","file_map":{"50":{"source":"use shared::constants::{MAX_DEPTH, MERKLE_TREE_DOMAIN};\nuse std::hash::poseidon2_permutation;\n\n/*\n* A binary merkle root implementation using Noir version 1.0.0-beta.22\n*\n* Inspired by: https://github.com/zk-kit/zk-kit.noir/tree/main/packages/binary-merkle-root\n*/\npub fn binary_merkle_root(\n    hasher: fn([Field; 2]) -> Field,\n    leaf: Field,\n    depth: u32,\n    indices: [bool; MAX_DEPTH],\n    siblings: [Field; MAX_DEPTH],\n) -> Field {\n    let mut node = leaf;\n\n    for i in 0..MAX_DEPTH {\n        if i < depth {\n            let sibling = siblings[i];\n\n            let (left, right) = if indices[i] {\n                (sibling, node)\n            } else {\n                (node, sibling)\n            };\n\n            node = hasher([left, right]);\n        }\n    }\n\n    node\n}\n\n/*\n* A poseidon wrapper that takes domain value, 1st input, 2nd input and zero for padding.\n* The poseidon2 blackbox expects 4 fields\n* This prevents collision between domains in merkle tree, note commitments and nullifiers\n*\n* @params xs: an array of 2 fields to be hashed\n*\n* @returns the poseidon hash\n*/\npub fn poseidon2(xs: [Field; 2]) -> Field {\n    poseidon2_permutation([MERKLE_TREE_DOMAIN, xs[0], xs[1], 0], 4)[0]\n}\n","path":"/home/nnico/ethereum/pq-shielded-pool/packages/circuits/transfer/src/lib.nr"},"51":{"source":"mod lib;\n\nuse crate::lib::{binary_merkle_root, poseidon2};\nuse shared::constants::{MAX_NEW_NOTES, NOTE_COMMITMENT_DOMAIN, NULLIFIER_DOMAIN};\nuse shared::types::{MerkleProof, Note};\nuse std::hash::poseidon2_permutation;\n\npub fn main(\n    old_note: Note,\n    new_notes: [Note; MAX_NEW_NOTES],\n    merkle_proof: MerkleProof,\n    nullifier: pub Field,\n    new_notes_commitments: pub [Field; MAX_NEW_NOTES],\n    published_root: pub Field,\n) {\n    let old_commitment = poseidon2_permutation(\n        [NOTE_COMMITMENT_DOMAIN, old_note.value as Field, old_note.owner, old_note.nonce],\n        4,\n    )[0];\n\n    let computed_nullifier = poseidon2_permutation(\n        [NULLIFIER_DOMAIN, old_note.value as Field, old_note.owner, old_note.nonce],\n        4,\n    )[0];\n\n    assert(computed_nullifier == nullifier, \"Nullifiers mismatch\");\n\n    let computed_root = binary_merkle_root(\n        poseidon2,\n        old_commitment,\n        merkle_proof.length,\n        merkle_proof.indices,\n        merkle_proof.siblings,\n    );\n\n    assert(computed_root == published_root, \"Roots mismatch\");\n\n    let mut remaining_value: u32 = old_note.value;\n\n    for i in 0..MAX_NEW_NOTES {\n        let note = new_notes[i];\n        let new_commitment = poseidon2_permutation(\n            [NOTE_COMMITMENT_DOMAIN, note.value as Field, note.owner, note.nonce],\n            4,\n        )[0];\n\n        assert(new_commitment == new_notes_commitments[i], \"New commitment mismatch\");\n\n        remaining_value -= note.value;\n    }\n\n    assert(remaining_value >= 0, \"Remaining value must be >= 0\");\n}\n","path":"/home/nnico/ethereum/pq-shielded-pool/packages/circuits/transfer/src/main.nr"}},"names":["main"],"brillig_names":["directive_integer_quotient"]}