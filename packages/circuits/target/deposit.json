{"noir_version":"1.0.0-beta.11+fd3925aaaeb76c76319f44590d135498ef41ea6c","hash":"2885989887742024628","abi":{"parameters":[{"name":"note","type":{"kind":"struct","path":"shared::types::Note","fields":[{"name":"value","type":{"kind":"integer","sign":"unsigned","width":32}},{"name":"asset","type":{"kind":"integer","sign":"unsigned","width":32}},{"name":"owner","type":{"kind":"field"}},{"name":"nonce","type":{"kind":"field"}}]},"visibility":"private"},{"name":"commitment","type":{"kind":"field"},"visibility":"public"},{"name":"value","type":{"kind":"integer","sign":"unsigned","width":32},"visibility":"public"}],"return_type":null,"error_types":{"6703277390738867884":{"error_kind":"string","string":"Commitment mismatch"},"7932861116973345373":{"error_kind":"string","string":"Value mismatch"}}},"bytecode":"","debug_symbols":"","file_map":{"50":{"source":"use shared::constants::NOTE_COMMITMENT_DOMAIN;\r\nuse shared::types::Note;\r\nuse std::hash::poseidon2_permutation;\r\n\r\npub fn main(note: Note, commitment: pub Field, value: pub u32) {\r\n    let precommitment = poseidon2_permutation(\r\n        [note.value as Field, note.owner, note.nonce, note.asset as Field],\r\n        4,\r\n    )[0];\r\n    let computed_commitment =\r\n        poseidon2_permutation([NOTE_COMMITMENT_DOMAIN, precommitment, 0, 0], 4)[0];\r\n\r\n    assert(computed_commitment == commitment, \"Commitment mismatch\");\r\n\r\n    assert(value == note.value, \"Value mismatch\");\r\n}","path":"/Users/yanisberger/pq-shielded-pool/packages/circuits/deposit/src/main.nr"}},"names":["main"],"brillig_names":[]}