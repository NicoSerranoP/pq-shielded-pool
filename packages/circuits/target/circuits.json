{"noir_version":"1.0.0-beta.11+fd3925aaaeb76c76319f44590d135498ef41ea6c","hash":"111815172935865579","abi":{"parameters":[{"name":"signature","type":{"kind":"struct","path":"types::Signature","fields":[{"name":"hashed_message","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}}},{"name":"pub_key_x","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}}},{"name":"pub_key_y","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}}},{"name":"signature","type":{"kind":"array","length":64,"type":{"kind":"integer","sign":"unsigned","width":8}}}]},"visibility":"private"},{"name":"old_note","type":{"kind":"struct","path":"types::Note","fields":[{"name":"value","type":{"kind":"integer","sign":"unsigned","width":32}},{"name":"owner","type":{"kind":"field"}},{"name":"nonce","type":{"kind":"field"}}]},"visibility":"private"},{"name":"new_notes","type":{"kind":"array","length":2,"type":{"kind":"struct","path":"types::Note","fields":[{"name":"value","type":{"kind":"integer","sign":"unsigned","width":32}},{"name":"owner","type":{"kind":"field"}},{"name":"nonce","type":{"kind":"field"}}]}},"visibility":"private"},{"name":"merkle_proof","type":{"kind":"struct","path":"types::MerkleProof","fields":[{"name":"length","type":{"kind":"integer","sign":"unsigned","width":32}},{"name":"indices","type":{"kind":"array","length":30,"type":{"kind":"boolean"}}},{"name":"siblings","type":{"kind":"array","length":30,"type":{"kind":"field"}}}]},"visibility":"private"},{"name":"nullifier","type":{"kind":"field"},"visibility":"public"},{"name":"new_notes_commitments","type":{"kind":"array","length":2,"type":{"kind":"field"}},"visibility":"public"},{"name":"published_root","type":{"kind":"field"},"visibility":"public"}],"return_type":null,"error_types":{"2411771206000632702":{"error_kind":"string","string":"New commitment mismatch"},"2920182694213909827":{"error_kind":"string","string":"attempt to subtract with overflow"},"5619814216780091991":{"error_kind":"string","string":"Old note owner mismatch"},"5695929252651659567":{"error_kind":"string","string":"Invalid signature"},"10577475009954280926":{"error_kind":"string","string":"Nullifiers mismatch"},"17080727174295616896":{"error_kind":"string","string":"Roots mismatch"}}},"bytecode":"","debug_symbols":"","file_map":{"51":{"source":"use crate::constants::{MAX_DEPTH, MERKLE_TREE_DOMAIN};\r\nuse std::hash::poseidon2_permutation;\r\n\r\n/*\r\n* A binary merkle root implementation using Noir version 1.0.0-beta.22\r\n*\r\n* Inspired by: https://github.com/zk-kit/zk-kit.noir/tree/main/packages/binary-merkle-root\r\n*/\r\npub fn binary_merkle_root<let MAX_DEPTH: u32>(\r\n    hasher: fn([Field; 2]) -> Field,\r\n    leaf: Field,\r\n    depth: u32,\r\n    indices: [bool; MAX_DEPTH],\r\n    siblings: [Field; MAX_DEPTH],\r\n) -> Field {\r\n    let mut node = leaf;\r\n\r\n    for i in 0..MAX_DEPTH {\r\n        if i < depth {\r\n            let sibling = siblings[i];\r\n\r\n            let (left, right) = if indices[i] {\r\n                (sibling, node)\r\n            } else {\r\n                (node, sibling)\r\n            };\r\n\r\n            node = hasher([left, right]);\r\n        }\r\n    }\r\n\r\n    node\r\n}\r\n\r\n/*\r\n* A poseidon wrapper that takes domain value, 1st input, 2nd input and zero for padding.\r\n* The poseidon2 blackbox expects 4 fields\r\n* This prevents collision between domains in merkle tree, note commitments and nullifiers\r\n*\r\n* @params xs: an array of 2 fields to be hashed\r\n*\r\n* @returns the poseidon hash\r\n*/\r\npub fn poseidon2(xs: [Field; 2]) -> Field {\r\n    poseidon2_permutation([MERKLE_TREE_DOMAIN, xs[0], xs[1], 0], 4)[0]\r\n}\r\n","path":"/Users/yanisberger/pq-shielded-pool/packages/circuits/src/lib.nr"},"52":{"source":"mod lib;\r\nmod types;\r\nmod constants;\r\n\r\nuse crate::constants::{MAX_DEPTH, MAX_NEW_NOTES, NOTE_COMMITMENT_DOMAIN, NULLIFIER_DOMAIN};\r\nuse crate::lib::{binary_merkle_root, poseidon2};\r\nuse crate::types::{MerkleProof, Note, Signature};\r\nuse std::ecdsa_secp256r1::verify_signature;\r\nuse std::field::bytes32_to_field;\r\nuse std::hash::poseidon2_permutation;\r\n\r\npub fn main(\r\n    signature: Signature,\r\n    old_note: Note,\r\n    new_notes: [Note; MAX_NEW_NOTES],\r\n    merkle_proof: MerkleProof,\r\n    nullifier: pub Field,\r\n    new_notes_commitments: pub [Field; MAX_NEW_NOTES],\r\n    published_root: pub Field,\r\n) {\r\n    let valid_signature = verify_signature(\r\n        signature.pub_key_x,\r\n        signature.pub_key_y,\r\n        signature.signature,\r\n        signature.hashed_message,\r\n    );\r\n\r\n    assert(valid_signature, \"Invalid signature\");\r\n\r\n    let pub_key_x_field = bytes32_to_field(signature.pub_key_x);\r\n    let pub_key_y_field = bytes32_to_field(signature.pub_key_y);\r\n    let old_owner = poseidon2_permutation([pub_key_x_field, pub_key_y_field, 0, 0], 4)[0];\r\n\r\n    assert(old_owner == old_note.owner, \"Old note owner mismatch\");\r\n\r\n    let old_commitment = poseidon2_permutation(\r\n        [NOTE_COMMITMENT_DOMAIN, old_note.value as Field, old_note.owner, old_note.nonce],\r\n        4,\r\n    )[0];\r\n\r\n    let computed_nullifier = poseidon2_permutation(\r\n        [NULLIFIER_DOMAIN, old_note.value as Field, old_note.owner, old_note.nonce],\r\n        4,\r\n    )[0];\r\n\r\n    assert(computed_nullifier == nullifier, \"Nullifiers mismatch\");\r\n\r\n    let computed_root = binary_merkle_root::<MAX_DEPTH>(\r\n        poseidon2,\r\n        old_commitment,\r\n        merkle_proof.length,\r\n        merkle_proof.indices,\r\n        merkle_proof.siblings,\r\n    );\r\n\r\n    assert(computed_root == published_root, \"Roots mismatch\");\r\n\r\n    let mut remaining_value: u32 = old_note.value;\r\n\r\n    for i in 0..MAX_NEW_NOTES {\r\n        let note = new_notes[i];\r\n        let new_commitment = poseidon2_permutation(\r\n            [NOTE_COMMITMENT_DOMAIN, note.value as Field, note.owner, note.nonce],\r\n            4,\r\n        )[0];\r\n\r\n        assert(new_commitment == new_notes_commitments[i], \"New commitment mismatch\");\r\n\r\n        remaining_value -= note.value;\r\n    }\r\n\r\n    assert(remaining_value >= 0, \"Remaining value must be >= 0\");\r\n}\r\n","path":"/Users/yanisberger/pq-shielded-pool/packages/circuits/src/main.nr"}},"names":["main"],"brillig_names":["directive_integer_quotient"]}