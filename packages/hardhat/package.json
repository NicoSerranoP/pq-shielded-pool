{
  "name": "@se-2/hardhat",
  "version": "0.0.1",
  "scripts": {
    "account": "hardhat run scripts/listAccount.ts",
    "account:generate": "hardhat run scripts/generateAccount.ts",
    "account:import": "hardhat run scripts/importAccount.ts",
    "account:reveal-pk": "hardhat run scripts/revealPK.ts",
    "atlantic:merkle:dry-run": "node scripts/submitAtlanticMerkle.mjs --dry-run --mock",
    "atlantic:merkle:mock": "node scripts/submitAtlanticMerkle.mjs --mock",
    "atlantic:merkle:real": "node scripts/submitAtlanticMerkle.mjs --real",
    "atlantic:merkle:task-pie:dry-run": "node scripts/submitAtlanticMerkle.mjs --dry-run --mock --testnet --result TRACE_GENERATION --declared-job-size L --layout all_cairo --pie-file ../cairo-merkle/target/local-proofs/recursive-verifier-task-pie.zip --no-satellite",
    "atlantic:merkle:task-pie:mock": "node scripts/submitAtlanticMerkle.mjs --mock --testnet --result PROOF_VERIFICATION_ON_L1 --declared-job-size L --layout all_cairo --pie-file ../cairo-merkle/target/local-proofs/recursive-verifier-task-pie.zip",
    "atlantic:merkle:task-pie:real": "node scripts/submitAtlanticMerkle.mjs --real --testnet --result PROOF_VERIFICATION_ON_L1 --declared-job-size L --layout all_cairo --pie-file ../cairo-merkle/target/local-proofs/recursive-verifier-task-pie.zip --interval-ms 15000 --timeout-ms 7200000",
    "atlantic:merkle:task-pie:resume-real": "node scripts/submitAtlanticMerkle.mjs --real --testnet --result PROOF_VERIFICATION_ON_L1 --declared-job-size L --layout all_cairo --query-id 01KTDCSWGYZAGANJZYY4E3MDGF --interval-ms 15000 --timeout-ms 7200000",
    "atlantic:merkle-poseidon:task-pie:dry-run": "node scripts/submitAtlanticMerkle.mjs --dry-run --mock --testnet --result TRACE_GENERATION --declared-job-size L --layout all_cairo --pie-file ../cairo-merkle-poseidon/target/local-proofs/recursive-verifier-task-pie.zip --no-satellite",
    "atlantic:merkle-poseidon:task-pie:real": "node scripts/submitAtlanticMerkle.mjs --real --testnet --result PROOF_VERIFICATION_ON_L1 --declared-job-size L --layout all_cairo --pie-file ../cairo-merkle-poseidon/target/local-proofs/recursive-verifier-task-pie.zip --interval-ms 15000 --timeout-ms 7200000",
    "atlantic:merkle-poseidon:task-pie:resume-real": "node scripts/submitAtlanticMerkle.mjs --real --testnet --result PROOF_VERIFICATION_ON_L1 --declared-job-size L --layout all_cairo --query-id 01KTDS2CJV6BTG555N0PSD2K9H --interval-ms 15000 --timeout-ms 7200000",
    "atlantic:merkle-poseidon:task-pie:resume-trace": "node scripts/submitAtlanticMerkle.mjs --mock --testnet --result TRACE_GENERATION --declared-job-size L --layout all_cairo --query-id 01KTDRW5T557A0A4908T1V9QKC --no-satellite --interval-ms 15000 --timeout-ms 7200000",
    "atlantic:merkle-poseidon:task-pie:trace": "node scripts/submitAtlanticMerkle.mjs --mock --testnet --result TRACE_GENERATION --declared-job-size L --layout all_cairo --pie-file ../cairo-merkle-poseidon/target/local-proofs/recursive-verifier-task-pie.zip --no-satellite --interval-ms 15000 --timeout-ms 7200000",
    "chain": "hardhat node --network hardhat --no-deploy",
    "check-types": "tsc --noEmit --incremental",
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "deploy": "ts-node scripts/runHardhatDeployWithPK.ts",
    "flatten": "hardhat flatten",
    "fork": "MAINNET_FORKING_ENABLED=true hardhat node --network hardhat --no-deploy",
    "format": "prettier --write './**/*.(ts|sol)'",
    "generate": "yarn account:generate",
    "hardhat-verify": "hardhat verify",
    "lint": "eslint",
    "lint-staged": "eslint",
    "test": "REPORT_GAS=true hardhat test --network hardhat",
    "verify": "hardhat etherscan-verify"
  },
  "dependencies": {
    "@inquirer/password": "^4.0.2",
    "@openzeppelin/contracts": "~5.0.2",
    "@typechain/ethers-v6": "~0.5.1",
    "dotenv": "~16.4.5",
    "envfile": "~7.1.0",
    "qrcode": "~1.5.4"
  },
  "devDependencies": {
    "@ethersproject/abi": "~5.7.0",
    "@ethersproject/providers": "~5.7.2",
    "@nomicfoundation/hardhat-chai-matchers": "~2.0.7",
    "@nomicfoundation/hardhat-ethers": "~3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "~1.0.11",
    "@nomicfoundation/hardhat-verify": "~2.0.10",
    "@typechain/ethers-v5": "~11.1.2",
    "@typechain/hardhat": "~9.1.0",
    "@types/eslint": "~9.6.1",
    "@types/mocha": "~10.0.10",
    "@types/prettier": "~3.0.0",
    "@types/qrcode": "~1.5.5",
    "@typescript-eslint/eslint-plugin": "~8.27.0",
    "@typescript-eslint/parser": "~8.27.0",
    "chai": "~4.5.0",
    "eslint": "~9.23.0",
    "eslint-config-prettier": "~10.1.1",
    "eslint-plugin-prettier": "~5.2.4",
    "ethers": "~6.13.2",
    "hardhat": "~2.28.2",
    "hardhat-deploy": "^1.0.4",
    "hardhat-deploy-ethers": "~0.4.2",
    "hardhat-gas-reporter": "~2.2.1",
    "prettier": "^3.5.3",
    "prettier-plugin-solidity": "~1.4.1",
    "solidity-coverage": "~0.8.13",
    "ts-node": "~10.9.1",
    "typechain": "~8.3.2",
    "typescript": "^5.8.2"
  }
}
