{
  "name": "se-2",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "account": "yarn hardhat:account",
    "account:generate": "yarn workspace @se-2/hardhat account:generate",
    "account:import": "yarn workspace @se-2/hardhat account:import",
    "account:reveal-pk": "yarn workspace @se-2/hardhat account:reveal-pk",
    "atlantic:merkle:dry-run": "yarn workspace @se-2/hardhat atlantic:merkle:dry-run",
    "atlantic:merkle:mock": "yarn workspace @se-2/hardhat atlantic:merkle:mock",
    "atlantic:merkle:real": "yarn workspace @se-2/hardhat atlantic:merkle:real",
    "atlantic:merkle:task-pie:dry-run": "yarn workspace @se-2/hardhat atlantic:merkle:task-pie:dry-run",
    "atlantic:merkle:task-pie:mock": "yarn workspace @se-2/hardhat atlantic:merkle:task-pie:mock",
    "atlantic:merkle:task-pie:real": "yarn workspace @se-2/hardhat atlantic:merkle:task-pie:real",
    "atlantic:merkle:task-pie:resume-real": "yarn workspace @se-2/hardhat atlantic:merkle:task-pie:resume-real",
    "atlantic:merkle-poseidon:task-pie:dry-run": "yarn workspace @se-2/hardhat atlantic:merkle-poseidon:task-pie:dry-run",
    "atlantic:merkle-poseidon:task-pie:real": "yarn workspace @se-2/hardhat atlantic:merkle-poseidon:task-pie:real",
    "atlantic:merkle-poseidon:task-pie:resume-real": "yarn workspace @se-2/hardhat atlantic:merkle-poseidon:task-pie:resume-real",
    "atlantic:merkle-poseidon:task-pie:resume-trace": "yarn workspace @se-2/hardhat atlantic:merkle-poseidon:task-pie:resume-trace",
    "atlantic:merkle-poseidon:task-pie:trace": "yarn workspace @se-2/hardhat atlantic:merkle-poseidon:task-pie:trace",
    "cairo:merkle:build": "cd packages/cairo-merkle && scarb build",
    "cairo:merkle:build-recursive-task-pie": "bash packages/cairo-merkle/scripts/build-recursive-task-pie.sh",
    "cairo:merkle:check-recursive-task-pie": "node packages/cairo-merkle/scripts/check-recursive-task-pie.mjs",
    "cairo:merkle:prepare-recursive-inputs": "node packages/cairo-merkle/scripts/prepare-recursive-proof-inputs.mjs",
    "cairo:merkle:prove-local": "bash packages/cairo-merkle/scripts/prove-local-stwo.sh",
    "cairo:merkle:test": "cd packages/cairo-merkle && scarb test",
    "cairo:merkle:verify-recursive-local": "bash packages/cairo-merkle/scripts/verify-recursive-local.sh",
    "cairo:merkle-poseidon:build": "cd packages/cairo-merkle-poseidon && scarb build",
    "cairo:merkle-poseidon:build-recursive-task-pie": "RECURSIVE_PROOF_ARGS=$PWD/packages/cairo-merkle-poseidon/target/local-proofs/merkle-poseidon-proof.blake-canonical.cairo-serde.array-args.json TASK_PIE_PATH=$PWD/packages/cairo-merkle-poseidon/target/local-proofs/recursive-verifier-task-pie.zip TASK_PIE_LOG_PATH=$PWD/packages/cairo-merkle-poseidon/target/local-proofs/recursive-verifier-task-pie.log TASK_PIE_CHECK_ARGS='--generic --expected-output 3,-1575579904327646194727519362278749901481907230895578035737745130512097599097,1,-845960492790892884656231863041640742943145074470692494761681786972233302565' bash packages/cairo-merkle/scripts/build-recursive-task-pie.sh",
    "cairo:merkle-poseidon:check-recursive-task-pie": "node packages/cairo-merkle/scripts/check-recursive-task-pie.mjs --pie packages/cairo-merkle-poseidon/target/local-proofs/recursive-verifier-task-pie.zip --log-file packages/cairo-merkle-poseidon/target/local-proofs/recursive-verifier-task-pie.log --generic --expected-output 3,-1575579904327646194727519362278749901481907230895578035737745130512097599097,1,-845960492790892884656231863041640742943145074470692494761681786972233302565",
    "cairo:merkle-poseidon:prepare-recursive-inputs": "node packages/cairo-merkle/scripts/prepare-recursive-proof-inputs.mjs --proof-path packages/cairo-merkle-poseidon/target/local-proofs/merkle-poseidon-proof.blake-canonical.cairo-serde.json --array-args-path packages/cairo-merkle-poseidon/target/local-proofs/merkle-poseidon-proof.blake-canonical.cairo-serde.array-args.json --atlantic-input-path packages/cairo-merkle-poseidon/target/local-proofs/merkle-poseidon-proof.blake-canonical.cairo-serde.atlantic.decimal.txt",
    "cairo:merkle-poseidon:prove-local": "bash packages/cairo-merkle-poseidon/scripts/prove-local-stwo.sh",
    "cairo:merkle-poseidon:prove-stone": "bash packages/cairo-merkle-poseidon/scripts/prove-local-stone.sh",
    "cairo:merkle-poseidon:prove-stone-legacy-gps": "bash packages/cairo-merkle-poseidon/scripts/prove-local-stone-legacy-gps.sh",
    "cairo:merkle-poseidon:prove-stone-legacy-gps:fork": "STONE_VERIFY_ON_FORK=true bash packages/cairo-merkle-poseidon/scripts/prove-local-stone-legacy-gps.sh",
    "cairo:merkle-poseidon:prove-stone-legacy-gps:sepolia-preflight": "node packages/cairo-merkle-poseidon/scripts/verify-stone-legacy-gps-sepolia.mjs --preflight-only",
    "cairo:merkle-poseidon:prove-stone-legacy-gps:sepolia": "node packages/cairo-merkle-poseidon/scripts/verify-stone-legacy-gps-sepolia.mjs",
    "cairo:merkle-poseidon:prove-recursive": "bash packages/cairo-merkle-poseidon/scripts/prove-recursive-blake-canonical.sh",
    "cairo:merkle-poseidon:test": "cd packages/cairo-merkle-poseidon && scarb test",
    "cairo:merkle-poseidon:verify-recursive-local": "bash packages/cairo-merkle-poseidon/scripts/verify-recursive-local.sh",
    "chain": "yarn hardhat:chain",
    "compile": "yarn hardhat:compile",
    "deploy": "yarn hardhat:deploy",
    "fork": "yarn hardhat:fork",
    "format": "yarn next:format && yarn hardhat:format",
    "generate": "yarn account:generate",
    "hardhat:account": "yarn workspace @se-2/hardhat account",
    "hardhat:chain": "yarn workspace @se-2/hardhat chain",
    "hardhat:check-types": "yarn workspace @se-2/hardhat check-types",
    "hardhat:clean": "yarn workspace @se-2/hardhat clean",
    "hardhat:compile": "yarn workspace @se-2/hardhat compile",
    "hardhat:deploy": "yarn workspace @se-2/hardhat deploy",
    "hardhat:flatten": "yarn workspace @se-2/hardhat flatten",
    "hardhat:fork": "yarn workspace @se-2/hardhat fork",
    "hardhat:format": "yarn workspace @se-2/hardhat format",
    "hardhat:generate": "yarn workspace @se-2/hardhat generate",
    "hardhat:hardhat-verify": "yarn workspace @se-2/hardhat hardhat-verify",
    "hardhat:lint": "yarn workspace @se-2/hardhat lint",
    "hardhat:lint-staged": "yarn workspace @se-2/hardhat lint-staged",
    "hardhat:test": "yarn workspace @se-2/hardhat test",
    "hardhat:test:cairo-fact": "yarn workspace @se-2/hardhat test test/CairoFactVerifier.ts",
    "hardhat:verify": "yarn workspace @se-2/hardhat verify",
    "postinstall": "husky install",
    "ipfs": "yarn workspace @se-2/nextjs ipfs",
    "lint": "yarn next:lint && yarn hardhat:lint",
    "next:build": "yarn workspace @se-2/nextjs build",
    "next:check-types": "yarn workspace @se-2/nextjs check-types",
    "next:format": "yarn workspace @se-2/nextjs format",
    "next:lint": "yarn workspace @se-2/nextjs lint",
    "next:serve": "yarn workspace @se-2/nextjs serve",
    "precommit": "lint-staged",
    "start": "yarn workspace @se-2/nextjs dev",
    "test": "yarn hardhat:test",
    "vercel": "yarn workspace @se-2/nextjs vercel",
    "vercel:login": "yarn workspace @se-2/nextjs vercel:login",
    "vercel:yolo": "yarn workspace @se-2/nextjs vercel:yolo",
    "verify": "yarn hardhat:verify"
  },
  "devDependencies": {
    "husky": "~9.1.6",
    "lint-staged": "~13.2.2"
  },
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=20.18.3"
  }
}
